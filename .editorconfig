root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,csproj,props,targets}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Language conventions
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = file_scoped:warning
dotnet_style_qualification_for_field = false:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
csharp_prefer_braces = true:silent

# Unused usings are removed by `dotnet format` (the lint step). IDE0005 is intentionally left at its
# default rather than escalated on build: enabling it on build requires GenerateDocumentationFile,
# which would then demand XML doc comments on every public member.
